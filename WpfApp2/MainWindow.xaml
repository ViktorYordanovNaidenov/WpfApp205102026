<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Управление на ученици" Height="380" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Лява страна: Полета и управление -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Име на ученик:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="NameBox" Height="28" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Text="Оценка (цяло число):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="GradeBox" Height="28" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button x:Name="AddButton"
                        Content="Добави" 
                        Width="105" Height="32" 
                        FontWeight="Bold" 
                        Margin="0,0,10,0" 
                        Click="AddButton_Click"/>

                <Button x:Name="SaveEditButton"
                        Content="Запази редакция" 
                        Width="125" Height="32" 
                        FontWeight="Bold" 
                        IsEnabled="False" 
                        Click="SaveEditButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusTextBlock" 
                       Text="Изберете ученик от списъка за редакция." 
                       FontSize="12" 
                       Foreground="Gray" 
                       TextWrapping="Wrap" 
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Дясна страна: Списък с ученици -->
        <DockPanel Grid.Column="1" Margin="15,0,0,0">
            <TextBlock DockPanel.Dock="Top" 
                       Text="Добавени ученици:" 
                       FontSize="13" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5"/>

            <ListBox x:Name="StudentsListBox" 
                     FontSize="13" 
                     SelectionChanged="StudentsListBox_SelectionChanged"/>
        </DockPanel>
    </Grid>
</Window>